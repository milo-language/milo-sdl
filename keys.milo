// USB HID scancodes — what SDL_GetKeyboardState() is indexed by.
//
// Physical key positions, not characters: SC_W is the key where W sits on QWERTY,
// which is where it sits on AZERTY too. That is what you want for movement keys and
// what you do not want for text entry.
//
// Every value is pinned to its SDL enumerator with @cValue, so a transcription error
// fails the build instead of producing a key that silently never fires.

@cValue("SDL_SCANCODE_A", "SDL2/SDL.h")
pub let SC_A: i64 = 4

@cValue("SDL_SCANCODE_B", "SDL2/SDL.h")
pub let SC_B: i64 = 5

@cValue("SDL_SCANCODE_C", "SDL2/SDL.h")
pub let SC_C: i64 = 6

